{
  "name": "pistead",
  "version": "0.9.0",
  "description": "Connect your Linux or WSL2 Pi host to a Pistead workspace, or run Pistead on your own computer.",
  "license": "MIT",
  "homepage": "https://pistead.com",
  "repository": { "type": "git", "url": "git+https://github.com/OpenCara/pistead.git", "directory": "packages/cli" },
  "keywords": ["pistead", "pi", "agent", "connector", "server"],
  "type": "module",
  "bin": { "pistead": "dist/pistead.js" },
  "files": ["dist", "npm-shrinkwrap.json"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "shrinkwrap": "node scripts/shrinkwrap.mjs",
    "prepublishOnly": "node scripts/shrinkwrap.mjs --check && pnpm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@hono/node-server": "1.19.11",
    "hono": "4.12.8",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
