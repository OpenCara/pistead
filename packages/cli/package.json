{
  "name": "pistead",
  "version": "0.8.0",
  "description": "Connect your Linux or WSL2 Pi host to a Pistead workspace.",
  "license": "MIT",
  "homepage": "https://pistead.com",
  "keywords": ["pistead", "pi", "agent", "connector"],
  "type": "module",
  "bin": { "pistead": "dist/pistead.js" },
  "files": ["dist", "npm-shrinkwrap.json"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/cli.js && esbuild src/pistead.ts --platform=node --format=esm --target=node16 --outfile=dist/pistead.js --banner:js=\"#!/usr/bin/env node\"",
    "shrinkwrap": "node scripts/shrinkwrap.mjs",
    "prepublishOnly": "node scripts/shrinkwrap.mjs --check && pnpm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "hono": "4.12.8",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
