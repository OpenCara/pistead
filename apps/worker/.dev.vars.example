APP_ORIGIN=http://localhost:8787
# Leave empty for user-connected Pi agents. Legacy development only: http://127.0.0.1:8788
RUNNER_URL=
RUNNER_EVENT_TRANSPORT=proxy
SESSION_SECRET=
# Required only for an explicitly configured legacy runner; never sent to connectors.
RUNNER_SHARED_SECRET=
# A base64url-encoded, cryptographically random 32-byte encryption key.
VAULT_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional operator GitHub App for github.com pushes (Repository contents: read & write). Leave empty to require
# workspace GitHub Apps. The private key is the app's PEM (PKCS#1 or PKCS#8), as one line with \n escapes.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# RSA private key (PKCS#8 PEM, 2048+ bits) for Pistead's OIDC issuer at APP_ORIGIN; Entra federation and Forgejo
# integrations trust its /.well-known/jwks.json. Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
OIDC_SIGNING_KEY=
# Loopback development and faux fixtures require all three explicit test settings.
TEST_AUTH_ENABLED=false
TEST_AUTH_SECRET=
TEST_AUTH_EXPIRES_AT=
