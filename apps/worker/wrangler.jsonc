{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opencara-agent-workspace-dev",
  "main": "src/worker-entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pistead.com", "custom_domain": true }],
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "opencara-agent-workspace-dev",
    "database_id": "ecb93821-3b79-4cb3-9465-664f9f11e399",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "opencara-agent-workspace-dev"
  }],
  "durable_objects": {
    "bindings": [{ "name": "CONNECTOR_HUB", "class_name": "ConnectorHub" }]
  },
  "migrations": [{ "tag": "v1-connectors", "new_sqlite_classes": ["ConnectorHub"] }],
  "vars": {
    "APP_ORIGIN": "https://pistead.com",
    "RUNNER_URL": "",
    "TEST_AUTH_ENABLED": "false",
    "TEST_AUTH_EXPIRES_AT": "",
    "GITHUB_CLIENT_ID": "Ov23liyoi7u2Ff6853PM",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_SLUG": ""
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
