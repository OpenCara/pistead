# Linux requires bubblewrap, Python 3, Git, and util-linux flock.
DATA_DIR=.data/runner
CONTROL_PLANE_URL=https://opencara-agent-workspace-dev.opencara.workers.dev
RUNNER_HOST=127.0.0.1
PORT=8788
# Generate independently, then install the same value as a Worker secret.
RUNNER_SHARED_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALLOW_FAUX_MODEL=false
# Generic shell is unavailable for real providers until per-session resource quotas exist.
ALLOW_TEST_SHELL=false
