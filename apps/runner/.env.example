# Optional operator-managed HTTP runner only.
# User connections use `pnpm connect` and the local Pi model configuration.
# Linux requires bubblewrap, Python 3, Git, and util-linux flock.
DATA_DIR=.data/runner
CONTROL_PLANE_URL=https://opencara-agent-workspace-dev.opencara.workers.dev
RUNNER_HOST=127.0.0.1
PORT=8788
# Legacy shared secret: never distribute this value to user-owned connectors.
RUNNER_SHARED_SECRET=
ALLOW_FAUX_MODEL=false
# Production shell requires verified per-session cgroup and private filesystem limits.
ALLOW_TEST_SHELL=false
