# Pistead server configuration. Copy to apps/server/.env (pnpm start) or .env next to docker-compose.yml.
# Values are read once at start-up; secrets are never logged.

# --- Listening -----------------------------------------------------------------------------------
# Public origin browsers and connectors use to reach this server (scheme + host, no path). HTTPS is
# required outside loopback test mode; terminate TLS in your reverse proxy.
APP_ORIGIN=https://pistead.example.com
# Bind address and port of the plain-HTTP listener.
HOST=0.0.0.0
PORT=8787
# Set to true only when a trusted reverse proxy sets X-Forwarded-Proto / X-Forwarded-Host.
TRUST_PROXY=false
# Directory with the built web client (pnpm build). Defaults to dist/web under the working directory.
STATIC_DIR=

# --- Providers -----------------------------------------------------------------------------------
# Database: sqlite:///absolute/path.sqlite (default sqlite:///data/pistead.sqlite; the directory
# must exist and be writable) or postgres://user:password@host:5432/database (TLS via ?sslmode=require).
DATABASE_URL=sqlite:///data/pistead.sqlite
# Session backups (optional). Empty, the default, stores none: nobody can create one, except in workspaces whose owner
# connected a database of their own (WORKSPACE_DATABASES below). To keep backups, choose a store:
# file:///absolute/dir, a directory on this server (file:///data/backups is the pistead-data volume under docker
# compose), or s3://bucket/optional/prefix?endpoint=https://s3.example.com&region=us-east-1 (endpoint enables
# path-style addressing for MinIO and similar; omit it for AWS). A backup holds a session's conversation and files and
# its owner's personal environment values: whoever can read the store can read them.
STORAGE_URL=
# S3 credentials (the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION names also work;
# leave all empty to use the SDK's default provider chain, e.g. instance roles).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Workspace databases (optional) --------------------------------------------------------------
# true lets workspace owners connect a Postgres database of their own (Settings → Workspaces → Session database):
# session backups of the workspace, with each session's record, are then saved there instead of in STORAGE_URL.
# The server opens connections to the hosts owners enter, so only hosts that resolve to public addresses are allowed.
# Unset, it is false, except in the Docker image, which sets true; an empty value also means false.
#WORKSPACE_DATABASES=false
# true also allows hosts that resolve to private, loopback or link-local addresses (and unencrypted connections to
# them). Only for deployments where every workspace owner may reach the server's own network.
WORKSPACE_DATABASE_PRIVATE_HOSTS=false

# --- Secrets (required) --------------------------------------------------------------------------
# Random string of at least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# A base64url-encoded, cryptographically random 32-byte encryption key:
# head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
VAULT_KEY=

# --- GitHub sign-in (optional) -------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional OAuth apps that let members connect document sources by signing in (README: Document sources). Each app's
# redirect URI is <APP_ORIGIN>/api/source-accounts/<provider>/oauth/callback, <provider> being google-drive, notion,
# dropbox, onedrive or tencent-docs. A provider left unset offers no sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=
# Optional operator GitHub App for github.com pushes (Repository contents: read & write). Leave empty to require
# workspace GitHub Apps. The private key is the app's PEM (PKCS#1 or PKCS#8), as one line with \n escapes.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# RSA private key (PKCS#8 PEM, 2048+ bits) for Pistead's OIDC issuer at APP_ORIGIN; Entra federation and Forgejo
# integrations trust its /.well-known/jwks.json. Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
OIDC_SIGNING_KEY=

# --- Git transfers (optional) --------------------------------------------------------------------
# Where sessions' Git data goes: on (default) lets hosts fetch from Git hosts themselves with credentials limited to one
# repository (public repositories need none), own-hosts gives credentials only to session owners' own hosts, and off
# relays every clone, fetch, push and Git LFS download through this server.
GIT_DIRECT=
# Sessions' gh and other GitHub API clients: on (default) gives every host running a session a GitHub App token that
# can only read the workspace's github.com repositories, which its egress proxy adds to api.github.com requests (the
# sandbox holds a placeholder); own-hosts only session owners' own hosts; off none.
SANDBOX_GITHUB_API=

# --- Web search (optional) -----------------------------------------------------------------------
# The search provider of the agent's web_search tool: brave, tavily or searxng; off (default) offers no search. Each
# workspace's owners and admins still turn web search on under Network access, since queries go to this provider.
WEB_SEARCH=
# Brave Search's or Tavily's API key (secret); for SearXNG an optional bearer token.
WEB_SEARCH_API_KEY=
# For searxng: the instance's origin, such as https://search.example.com, with its JSON output turned on.
WEB_SEARCH_URL=

# --- Accounts (optional) -------------------------------------------------------------------------
# true offers sign-in with a username and password, as password:<username>, next to GitHub or instead of it. Not with
# LOCAL_MODE. Create the first administrator with: node dist/server/main.js --create-admin USERNAME
PASSWORD_AUTH=
# Who can create an account, with GitHub and with a password: open (anyone who reaches the server), invite (only through
# a workspace's invite link) or off (only ADMIN_USER_IDS's GitHub accounts and --create-admin). Unset: GitHub open, as
# before, and passwords invite.
SIGNUP=

# --- Administration (optional) -------------------------------------------------------------------
# Comma-separated user IDs (Settings → Profile, e.g. github:12345 or password:alice) of this server's administrators: they
# see every account, workspace and host under Settings → Administration and can suspend accounts. Only this setting
# grants it. A GitHub ID is github: and the number https://api.github.com/users/<login> shows as id. Nobody can sign up as
# a password account listed here: create it with --create-admin.
ADMIN_USER_IDS=

# --- Legacy shared runner (optional) -------------------------------------------------------------
# Leave empty for user-connected Pi agents. Legacy development only: http://127.0.0.1:8788
RUNNER_URL=
RUNNER_EVENT_TRANSPORT=proxy
# Required only for an explicitly configured legacy runner; never sent to connectors.
RUNNER_SHARED_SECRET=

# --- Test authentication (development only) -----------------------------------------------------
# Loopback development and faux fixtures require all three explicit test settings.
TEST_AUTH_ENABLED=false
TEST_AUTH_SECRET=
TEST_AUTH_EXPIRES_AT=
